{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "types": [
      "bun-types"
    ],
    "baseUrl": ".",
    "paths": {
      "yinzerflow": [
        "../lib",
        "../lib/index.d.ts"
      ]
    }
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}